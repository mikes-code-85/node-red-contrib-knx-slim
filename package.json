{
  "name": "node-red-contrib-knx-ultimate",
  "engines": {
    "node": ">=20.18.1"
  },
  "version": "7.1.0-beta.1",
  "description": "KNX Ultimate is a lean KNX integration for Node-RED, providing secure KNX/IP communication, routing, ETS project import, diagnostics, virtual devices, and core automation nodes. Build professional, reliable, and scalable smart home and building automation projects with minimal effort.",
  "files": [
    "nodes/",
    "resources/",
    "examples/",
    "img/logo-big.png",
    "img/readmemain.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "knxultimate": "6.0.6",
    "lodash": "4.18.1",
    "ping": "0.4.4",
    "simple-get": "4.0.1",
    "winston": "^3.17.0"
  },
  "node-red": {
    "version": ">=3.1.1",
    "plugins": {
      "commonFunctions": "/nodes/commonFunctions.js",
      "knxUltimateFlowBubbles": "/nodes/plugins/knxUltimate-flow-bubbles-plugin.html"
    },
    "nodes": {
      "knxUltimate": "/nodes/knxUltimate.js",
      "knxUltimateUtility": "/nodes/knxUltimateUtility.js",
      "knxUltimateDateTime": "/nodes/knxUltimateDateTime.js",
      "knxUltimateGlobalContext": "/nodes/knxUltimateGlobalContext.js",
      "knxUltimateAlerter": "/nodes/knxUltimateAlerter.js",
      "knxUltimateMultiRouting": "/nodes/knxUltimateMultiRouting.js",
      "knxUltimateRouterFilter": "/nodes/knxUltimateRouterFilter.js",
      "knxUltimateAutoResponder": "/nodes/knxUltimateAutoResponder.js",
      "knxUltimateWatchDog": "/nodes/knxUltimateWatchDog.js",
      "knxUltimate-config": "/nodes/knxUltimate-config.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Supergiovane/node-red-contrib-knx-ultimate.git"
  },
  "keywords": [
    "node-red",
    "node-red-contrib",
    "KNX",
    "knx-secure",
    "ETS",
    "eib",
    "konnex",
    "home-assistant",
    "building-automation",
    "home-automation",
    "smarthome",
    "routing"
  ],
  "author": {
    "name": "Massimo Saccani",
    "email": "maxsupergiovane@icloud.com",
    "url": "https://youtube.com/@maxsupervibe"
  },
  "license": "MIT",
  "scripts": {
    "build": "echo No build required",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "npm run knx-utility:check && npm run test:unit && node scripts/check-node-load.js",
    "test:unit": "mocha \"test/**/*.test.js\"",
    "release:publish": "node scripts/publish-and-refresh.js",
    "release:refresh-flows": "node scripts/publish-and-refresh.js --refresh-only",
    "avviaquesto-itest:knxbus": "node test/integration/knxLightTest.js",
    "avviaquesto-itest:buildflow": "node test/integration/buildTestFlow.js",
    "avviaquesto-itest:serve": "node test/integration/serveFlow.mjs",
    "lint:fix": "standard --fix",
    "lint-fix": "standard --fix",
    "knx-utility:generate": "node scripts/generate-knx-utility-profiles.js",
    "knx-utility:check": "node scripts/generate-knx-utility-profiles.js --check"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "chai": "^4.3.10",
    "js-yaml": "4.3.2",
    "marked": "^14.1.0",
    "mocha": "^10.4.0",
    "vite": "^7.3.6",
    "vue": "^3.5.41"
  }
}